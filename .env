# Optional AI API Keys for conversational responses
# If blank, the system uses built-in responses (clock, date, echo, status)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Dictation settings
DICTATE_TO_MACOS=true
SPEAK_RESPONSE=true

# Text to Speech voice
TTS_ENGINE=edge-tts
TTS_VOICE_EDGE=th-TH-PremwadeeNeural
